# ---- Server ----
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts SMTP passwords + Slack webhooks at rest (AES-256-GCM). Any long random string.
# If empty, a key is derived from JWT_SECRET (fine for local dev).
ENCRYPTION_KEY=
# Comma-separated emails allowed to open /admin/queues. Empty = any signed-in user (local dev).
ADMIN_EMAILS=

# ---- Infra (defaults match docker-compose.yml) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=emails

# ---- Google OAuth (console.cloud.google.com → Credentials → OAuth client, type Web) ----
# Authorised redirect URI: ${BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Slack OAuth (api.slack.com/apps → OAuth & Permissions) ----
# Bot scopes: incoming-webhook, chat:write   Redirect URL: ${BACKEND_URL}/api/slack/callback (must be https)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---- Ethereal SMTP ----
# Leave empty to auto-create ETHEREAL_SENDER_COUNT test accounts on first boot,
# or provide your own: user1@ethereal.email:pass1,user2@ethereal.email:pass2
ETHEREAL_SENDERS=
ETHEREAL_SENDER_COUNT=3
DRY_RUN_SMTP=false

# ---- Throughput & rate limiting ----
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR=1000
JOB_ATTEMPTS=3
